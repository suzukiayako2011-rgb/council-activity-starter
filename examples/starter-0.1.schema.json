{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "議会活動スターター starter-0.1（暫定）",
  "type": "object",
  "required": [
    "schema_version",
    "dataset",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "starter-0.1"
    },
    "dataset": {
      "type": "object",
      "required": [
        "slug"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "date",
          "meeting_type",
          "committee",
          "session_name",
          "question_topic",
          "issue",
          "proposal",
          "answer_summary",
          "result_level",
          "tags",
          "local_tags",
          "source_type",
          "source_url",
          "follow_up"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{6}$"
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "meeting_type": {
            "enum": [
              "本会議",
              "委員会",
              "特別委員会",
              "予算提案",
              null
            ]
          },
          "committee": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "session_name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "question_topic": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "issue": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "proposal": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "answer_summary": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "result_level": {
            "enum": [
              "実施済",
              "改善・対応予定",
              "検討を引き出した",
              "研究段階",
              "提案のみ",
              "適正確認",
              null
            ]
          },
          "tags": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "enum": [
                "DX",
                "まちづくり",
                "スポーツ",
                "人権・多様性",
                "保健衛生・医療",
                "子ども・子育て",
                "市民活動",
                "教育",
                "文化芸術",
                "環境",
                "社会福祉",
                "経済・雇用",
                "行政運営",
                "議会改革",
                "防災・消防"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "local_tags": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_type": {
            "enum": [
              "議事録",
              "予算提案",
              null
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https?://\\S+$"
          },
          "follow_up": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[^\\r\\n]+。（出典：https?://\\S+、[0-9]{4}年[0-9]{2}月[0-9]{2}日確認）$",
            "description": "暫定・将来変換対象。人が確認した事実・出典URL・確認日。因果は主張しない。"
          }
        }
      }
    }
  }
}
